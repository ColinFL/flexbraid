# FlexBraid client config — OPNsense office router.
#
# After install: set crypto.key to your PSK (same as the server),
# set server to your VPS, then: service flexbraid start
mode: client
listen: 127.0.0.1:51820        # inner WireGuard interface connects here
server: 203.0.113.10:4096      # public FlexBraid server address:port
#
# FEC and inner MTU are SERVER-PUSHED: the server announces them in the
# key-exchange ACK and the client adopts them. Do not set fec:/mtu here.
# Set your WireGuard interface MTU to the value the server advertises.
#
scheduler:
  mode: lb
  affinity: packet
  balance_by: capacity

wans:
  - id: w1
    transport: udp
    # On FreeBSD 15 do NOT set iface (IP_BOUND_IF removed). Optional if the
    # WAN has a real address:
    # local_ip: 192.0.2.10
    capacity_mbps: 300

delivery:
  gap_timeout_ms: 150
  max_pending: 4096

health:
  probe_interval: 1
  down_after_misses: 3
  down_grace_sec: 1
  recover_min: 2

queue:
  enabled: true
  max_bytes: 262144
  drop: oldest                 # "oldest" (TCP-ish) | "newest" (real-time)
  rate_limit: true

crypto:
  key: "change-me"             # REQUIRED: replace with your 32-byte hex PSK
  cipher: chacha20poly1305

log:
  level: info
